{
    "name": "sohan-manager-backend",
    "version": "0.1.0",
    "private": true,
    "description": "Enterprise licensing backend for Sohan Manager",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "lint": "eslint . --ext .ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev --name init",
        "seed": "node dist/prisma/seed.js",
        "seed:admin": "node scripts/seed_admin.js",
        "docker:build": "docker build -t sohan-manager-backend ."
    },
    "dependencies": {
        "@prisma/client": "^5.15.0",
        "jsonwebtoken": "^9.0.0",
        "argon2": "^0.45.1",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.0.0",
        "tweetnacl": "^1.0.3",
        "zod": "^3.23.2"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.17",
        "@types/node": "^20.19.43",
        "@typescript-eslint/eslint-plugin": "^7.13.0",
        "@typescript-eslint/parser": "^7.13.0",
        "@vitest/ui": "^4.1.10",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.32.0",
        "prettier": "^3.0.0",
        "prisma": "^5.15.0",
        "ts-node-dev": "^2.0.0",
        "tsup": "^8.5.1",
        "typescript": "^5.5.4",
        "vitest": "^4.1.10"
    }
}