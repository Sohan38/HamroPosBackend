generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String         @id @db.VarChar(36)
  name       String         @db.VarChar(255)
  createdAt  DateTime       @default(now()) @db.Timestamp(6)
  updatedAt  DateTime       @default(now()) @updatedAt @db.Timestamp(6)
  subscriptions Subscription[]
}

model Plan {
  id           String            @id @db.VarChar(50)
  name         String            @db.VarChar(100)
  maxDevices   Int               @default(1)
  price        Float?
  description  String?
  createdAt    DateTime          @default(now()) @db.Timestamp(6)
  entitlements PlanEntitlement[]
  subscriptions Subscription[]
}

model Feature {
  id          String                  @id @db.VarChar(100)
  name        String                  @db.VarChar(255)
  valueType   String                  @default("boolean") @db.VarChar(20)
  description String?
  planEntitlements PlanEntitlement[]
  licenseOverrides LicenseEntitlementOverride[]
}

model PlanEntitlement {
  planId       String    @db.VarChar(50)
  featureId    String    @db.VarChar(100)
  booleanValue Boolean   @default(true)
  numericValue Int?

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
}

model Subscription {
  id                 String    @id @db.VarChar(36)
  organizationId     String    @db.VarChar(36)
  planId             String    @db.VarChar(50)
  status             String    @default("trial") @db.VarChar(20)
  billingCycle       String    @default("yearly") @db.VarChar(20)
  isLifetime         Boolean   @default(false)
  startsAt           DateTime
  expiresAt          DateTime?
  gracePeriodDays    Int       @default(7)
  cancelledAt        DateTime?
  paymentProviderRef String?   @db.VarChar(255)
  createdAt          DateTime  @default(now()) @db.Timestamp(6)
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  licenses     License[]
  invoices     Invoice[]
}

model License {
  id                    String                        @id @db.VarChar(36)
  subscriptionId        String                        @db.VarChar(36)
  activationKeyLookup   String                        @unique @db.VarChar(64)
  activationKeyVerify   String                        @db.VarChar(255)
  status                String                        @default("active") @db.VarChar(20)
  maxDevicesOverride    Int?
  createdAt             DateTime                      @default(now()) @db.Timestamp(6)
  updatedAt             DateTime                      @default(now()) @updatedAt @db.Timestamp(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  overrides    LicenseEntitlementOverride[]
  devices      Device[]
  activationLogs ActivationLog[]
}

model LicenseEntitlementOverride {
  licenseId   String  @db.VarChar(36)
  featureId   String  @db.VarChar(100)
  booleanValue Boolean?
  numericValue Int?

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([licenseId, featureId])
}

model Device {
  id           String   @id @db.VarChar(36)
  licenseId    String   @db.VarChar(36)
  platform     String   @db.VarChar(30)
  manufacturer String?  @db.VarChar(100)
  model        String?  @db.VarChar(100)
  appVersion   String   @db.VarChar(30)
  lastSeenAt   DateTime @default(now()) @db.Timestamp(6)
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  activationLogs ActivationLog[]
}

model ActivationLog {
  id            BigInt    @id @default(autoincrement())
  licenseId     String?   @db.VarChar(36)
  deviceId      String?   @db.VarChar(36)
  ipAddress     String    @db.VarChar(45)
  userAgent     String?
  action        String    @db.VarChar(50)
  isSuccess     Boolean
  failureReason String?   @db.VarChar(255)
  createdAt     DateTime  @default(now()) @db.Timestamp(6)

  license License? @relation(fields: [licenseId], references: [id], onDelete: NoAction)
  device  Device?  @relation(fields: [deviceId], references: [id], onDelete: NoAction)
}

model Invoice {
  id               String   @id @db.VarChar(36)
  subscriptionId   String   @db.VarChar(36)
  provider         String   @db.VarChar(50)
  providerInvoiceId String?  @db.VarChar(255)
  amountPaid       Int
  currency         String   @db.VarChar(10)
  status           String   @db.VarChar(50)
  rawPayload       Json
  createdAt        DateTime @default(now()) @db.Timestamp(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model ProcessedEvent {
  id               BigInt   @id @default(autoincrement())
  provider         String   @db.VarChar(50)
  providerEventId  String   @db.VarChar(255)
  eventType        String   @db.VarChar(100)
  createdAt        DateTime @default(now()) @db.Timestamp(6)

  @@unique([provider, providerEventId])
}

model AdminUser {
  id           String   @id @db.VarChar(36)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         String   @db.VarChar(50)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

// Audit logs for administrator actions
model AdminAudit {
  id             BigInt   @id @default(autoincrement())
  adminId        String   @db.VarChar(36)   // acting admin id
  targetAdminId  String?  @db.VarChar(36)   // target admin (if applicable)
  action         String   @db.VarChar(100)
  details        String?  @db.VarChar(1024)
  isSuccess      Boolean  @default(true)
  ipAddress      String?  @db.VarChar(45)
  userAgent      String?
  createdAt      DateTime @default(now()) @db.Timestamp(6)
}

model PrismaMigrations {
  id                   Int      @id @default(autoincrement())
  checksum             String
  finishedAt           DateTime?
  migrationName        String
  logs                 String?
  rolledBackAt         DateTime?
  appliedStepsCount    Int
  startedAt            DateTime?
  stepCount            Int
}
