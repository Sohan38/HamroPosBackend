# Server configuration
NODE_ENV=production
PORT=4000

# Database configuration
DATABASE_URL=postgres://postgres:postgres@db:5432/sohan_manager

# Security and auth
JWT_SECRET=replace-with-a-secure-jwt-secret
ED25519_PRIVATE_KEY=replace-with-a-64-byte-ed25519-private-key
ED25519_PUBLIC_KEY=replace-with-a-32-byte-ed25519-public-key
ED25519_PUBLIC_KEYS=

# Admin bootstrap (only enable one-time initial setup)
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_API_KEY=replace-with-a-secure-bootstrap-key

# Billing webhook configuration
BILLING_PROVIDER=generic
BILLING_WEBHOOK_SECRET=
BILLING_STRIPE_WEBHOOK_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=5

# CORS
ALLOWED_ORIGINS=http://localhost:3000
